{
  "name": "@stackline/deep-copy",
  "version": "1.0.2",
  "description": "Compatibility-first legacy deep copying with cycle support and safe property handling",
  "keywords": [
    "stackline",
    "npm-package",
    "deep-copy",
    "typescript",
    "nodejs",
    "deep",
    "copy",
    "clone",
    "object",
    "array",
    "cyclic-objects"
  ],
  "license": "MIT",
  "author": "Stackline maintainers",
  "contributors": [
    "Simeon Velichkov <simeonvelichkov@gmail.com> (original deep-copy author)"
  ],
  "homepage": "https://alexandro.net/docs/vanilla/deep-copy/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-deep-copy.git"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-deep-copy/issues"
  },
  "main": "./index.js",
  "module": "./index.mjs",
  "type": "commonjs",
  "sideEffects": false,
  "types": "./index.d.ts",
  "typings": "./index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./index.d.mts",
        "require": "./index.d.cts",
        "default": "./index.d.ts"
      },
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./index": {
      "types": {
        "import": "./index.d.mts",
        "require": "./index.d.cts",
        "default": "./index.d.ts"
      },
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
      "types": {
        "import": "./index.d.mts",
        "require": "./index.d.cts",
        "default": "./index.d.ts"
      },
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.cts",
    "index.d.mts",
    "examples",
    "CHANGELOG.md",
    "COMPATIBILITY_CONTRACT.md",
    "LICENSE",
    "MIGRATION.md",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "engines": {
    "node": ">=4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint index.js index.mjs scripts test examples docs-site",
    "test:upstream": "node --test test/upstream.test.cjs",
    "test:differential": "node --test test/differential.test.cjs",
    "test:contract": "node --test test/compatibility.test.cjs test/malformed-security.test.cjs",
    "test:stress": "node --test test/stress.test.cjs",
    "test:browser": "node --test test/browser.test.cjs",
    "test:esm": "node test/esm.mjs",
    "test:types": "node node_modules/typescript-3-9/bin/tsc -p test/types/tsconfig.legacy.json && node node_modules/typescript/bin/tsc -p test/types/tsconfig.commonjs.json && node node_modules/typescript/bin/tsc -p test/types/tsconfig.modern.json",
    "test:runtime": "node scripts/check-runtime.mjs",
    "test": "npm run test:upstream && npm run test:differential && npm run test:contract && npm run test:stress && npm run test:browser && npm run test:esm && npm run test:types && npm run test:runtime",
    "test:coverage": "c8 --all --include=index.js --check-coverage --lines 95 --functions 90 --branches 85 node --test test/upstream.test.cjs test/differential.test.cjs test/compatibility.test.cjs test/malformed-security.test.cjs test/stress.test.cjs test/browser.test.cjs",
    "test:smoke": "node scripts/smoke-install.mjs",
    "test:closure": "node scripts/check-production-closure.mjs",
    "test:docs": "npm run docs:build && npm run docs:check",
    "check:package": "publint && attw --pack .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:sbom": "node scripts/check-sbom.mjs",
    "check:release": "node scripts/check-release.mjs",
    "pack:check": "npm pack --dry-run",
    "audit:dependencies": "npm audit --omit=dev --audit-level=low",
    "audit:all": "npm audit --audit-level=low",
    "audit:signatures": "npm audit signatures",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "verify": "npm run clean && npm run lint && npm run build && npm test && npm run test:coverage && npm run test:smoke && npm run test:closure && npm run check:package && npm run check:licenses && npm run check:sbom && npm run check:release && npm run pack:check && npm run test:docs && npm run audit:dependencies && npm run audit:all && npm run audit:signatures",
    "artifact:prepare": "node scripts/create-artifact.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "c8": "12.0.0",
    "deep-copy-upstream": "npm:deep-copy@1.4.2",
    "eslint": "10.9.1",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "typescript-3-9": "npm:typescript@3.9.10"
  }
}
